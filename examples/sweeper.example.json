{
  "workspace": "./sweeper-data",
  "user_agent": "Example University Sweeper V2/0.1 (archives@example.edu)",
  "layout": {"major_slots": 2, "minor_slots": 1},
  "policy": {
    "languages": ["en"],
    "licenses": ["CC0-1.0", "CC-BY-4.0", "PUBLIC-DOMAIN"],
    "media_types": ["application/json", "application/xml", "text/plain", "text/html"],
    "artifact_classes": ["document", "dataset", "archive", "public-record", "media"],
    "data_classes": ["open-public", "institution-authorized"],
    "minimum_bytes": 1,
    "maximum_bytes": 1073741824,
    "require_language": true,
    "require_license": true,
    "reviewer_command": []
  },
  "sources": [
    {"id":"major-one","slot":1,"lane":"major","manifest":"./manifests/major-one.jsonl","workers":2,"requests_per_second":1.0},
    {"id":"major-two","slot":2,"lane":"major","manifest":"./manifests/major-two.jsonl","workers":2,"requests_per_second":1.0},
    {"id":"minor-one","slot":1,"lane":"minor","manifest":"./manifests/minor-one.jsonl","continuation_manifests":[],"target_items":500,"workers":1,"requests_per_second":0.5}
  ]
}
